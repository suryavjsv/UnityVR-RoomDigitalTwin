# ═══════════════════════════════════════════════
# Room Digital Twin — .gitignore
# Unity + Arduino + Firebase + General
# ═══════════════════════════════════════════════

# ──────────────────────────────────────────────
# CREDENTIALS — NEVER COMMIT THESE
# ──────────────────────────────────────────────
**/secrets.*
**/credentials.*
**/config.secret.*
firebase.json
.firebaserc
google-services.json
GoogleService-Info.plist
serviceAccountKey.json

# ──────────────────────────────────────────────
# UNITY
# ──────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Asset meta files should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Visual Studio / Rider cache
.vs/
.idea/
*.sln
*.csproj
*.unityproj
*.suo
*.tmp
*.utmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated VS/MD solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.utmp
*.user
*.userprefs
*.pidb
*.booproj

# Unity3D generated file on crash reports
sysinfo.txt

# Asset Server
*.cachefile

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ──────────────────────────────────────────────
# ARDUINO / ESP32
# ──────────────────────────────────────────────
# Arduino build artifacts
build/
*.elf
*.bin
*.hex
*.map

# Arduino cache
.arduino15/
arduino-cli.yaml

# PlatformIO (if migrating)
.pio/
.pioenvs/
.piolibdeps/

# ──────────────────────────────────────────────
# NODE / NPM (Firebase CLI tools)
# ──────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
.npm

# ──────────────────────────────────────────────
# PYTHON (if using scripts)
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.env
venv/
.venv/

# ──────────────────────────────────────────────
# LOGS & TEMP
# ──────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.swp
*.orig

# ──────────────────────────────────────────────
# LARGE MEDIA — track with Git LFS instead
# ──────────────────────────────────────────────
*.psd
*.ai
*.fbx
*.obj
*.3ds
*.max
*.blend
*.dae
*.mb
*.ma
*.mp4
*.mov
*.avi
*.wav
*.mp3

# ──────────────────────────────────────────────
# KEEP THESE (force include)
# ──────────────────────────────────────────────
!.gitignore
!README.md
!architecture.svg
!/Arduino/**/*.ino
!/Unity/Assets/Scripts/**/*.cs
